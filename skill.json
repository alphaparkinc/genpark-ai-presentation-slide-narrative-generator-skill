{
  "name": "genpark-ai-presentation-slide-narrative-generator-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - AI presentation architect that converts raw data and bullet points into structured slide narratives with speaker notes and visual layout specs.",
  "author": "genpark",
  "category": "productivity",
  "tags": [
